# Kimia Pintar — environment
# Copy to .env.local and fill in. Without these the app runs on mock data;
# with them it uses your real Supabase project.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only (never exposed to the browser). Used for privileged admin ops and
# server-side answer-key delivery. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: absolute site URL used for auth email redirect links.
# Defaults to the request origin if unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
